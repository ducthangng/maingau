# AI backend for the AI steps (nba/ai): copy this file to .env and fill in the key.
# .env is git-ignored: the team key must never be committed (the repository is public).

MAINGAU_LLM=hessian

# Hessian.AI inference gateway (team access sheet): one key per team, do not share it.
HAI_API_KEY=
# vllm/Kolibri-1 or vllm/GLM-Flash:Latest
HAI_MODEL=vllm/Kolibri-1
# HAI_BASE_URL=https://hip-gw.hessian.ai/v1
