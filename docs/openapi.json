            "enum": [
              "newsletter_email",
              "email",
              "portal_popup",
              "app_push",
              "sms",
              "outbound_call",
              "service_agent"
            ],
            "title": "Channel",
            "type": "string"
          },
          "offer_id": {
            "title": "Offer Id",
            "type": "string"
          },
          "tone": {
            "enum": [
              "du",
              "sie"
            ],
            "title": "Tone",
            "type": "string"
          }
        },
        "required": [
          "offer_id",
          "channel",
          "tone"
        ],
        "title": "TupleRef",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
